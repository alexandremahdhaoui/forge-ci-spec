{
  "_comment": [
    "Conformance vectors for the forge-ci pipeline schema.",
    "",
    "Every forge-ci implementation reads THIS file. A vector in invalid must",
    "fail, and the reported error must contain the substring in error.",
    "",
    "Schema alone cannot check a cross reference. An alias that names nothing,",
    "or names an engine of the wrong port, is a semantic check the validator",
    "must perform. Those vectors are marked semantic true."
  ],

  "valid": [
    {
      "case": "minimal",
      "why": "one repo, one engine, one stage. The smallest thing that runs.",
      "doc": {
        "name": "minimal",
        "managers": [{ "alias": "local", "engine": "forge://x/cmd/ci-manager-local@v0.1.0" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x/cmd/ci-compute-local@v0.1.0", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://x/cmd/ci-state-git@v0.1.0", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "build", "forge": "test-all" }],
        "stages": [
          { "name": "build", "substages": [
            { "name": "default", "engine": "here", "manager": "local", "targets": ["build"] }
          ]}
        ]
      }
    },
    {
      "case": "no-repos",
      "why": "repos is optional. A pipeline with none is valid and its revision is the pipeline file.",
      "doc": {
        "name": "norepos",
        "managers": [{ "alias": "local", "engine": "forge://x/cmd/ci-manager-local@v0.1.0" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x/cmd/ci-compute-local@v0.1.0", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://x/cmd/ci-state-git@v0.1.0", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "noop", "forgeCI": "status" }],
        "stages": [
          { "name": "s", "substages": [
            { "name": "d", "engine": "here", "manager": "local", "targets": ["noop"] }
          ]}
        ]
      }
    },
    {
      "case": "many-substages",
      "why": "a stage fans out. Substages carry user params that forge-ci never interprets.",
      "doc": {
        "name": "fanout",
        "managers": [{ "alias": "local", "engine": "forge://x/cmd/ci-manager-local@v0.1.0" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x/cmd/ci-compute-local@v0.1.0", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://x/cmd/ci-state-git@v0.1.0", "manager": "local" },
          { "alias": "approve", "type": "gate", "engine": "forge://x/cmd/ci-gate-manual@v0.1.0", "manager": "local" },
          { "alias": "all-pass", "type": "promotion", "engine": "forge://x/cmd/ci-promotion-all@v0.1.0", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "deploy", "forge": "run deploy --region {{.Params.region}} --cell {{.Params.cell}}" }],
        "stages": [
          { "name": "prod", "promotion": "all-pass", "substages": [
            { "name": "eu-a", "engine": "here", "manager": "local", "gates": ["approve"], "targets": ["deploy"], "params": { "region": "eu-west-1", "cell": "a" } },
            { "name": "eu-b", "engine": "here", "manager": "local", "gates": ["approve"], "targets": ["deploy"], "params": { "region": "eu-west-1", "cell": "b" } }
          ]}
        ]
      }
    },
    {
      "case": "alias-engine-uri",
      "why": "alias:// resolves as well as forge://, matching forge.",
      "doc": {
        "name": "aliased",
        "managers": [{ "alias": "local", "engine": "alias://my-manager" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "alias://my-compute", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://x/cmd/ci-state-git@v0.1.0", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [
          { "name": "s", "substages": [
            { "name": "d", "engine": "here", "manager": "local", "targets": ["t"] }
          ]}
        ]
      }
    }
  ],

  "invalid": [
    {
      "case": "no-stages",
      "why": "a pipeline with no stages does nothing and is almost certainly a mistake.",
      "error": "stages",
      "semantic": false,
      "doc": { "name": "x", "engines": [], "state": "st", "stages": [] }
    },
    {
      "case": "go-scheme-removed",
      "why": "the go:// scheme is removed. A migration must not fail silently: the error names forge://.",
      "error": "forge://",
      "semantic": false,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "go://x/cmd/ci-manager-local@v0.1.0" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "local" }],
        "state": "st",
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "bad-engine-scheme",
      "why": "only forge:// and alias:// resolve. Matching forge, anything else is a hard error.",
      "error": "engine",
      "semantic": false,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "https://example.com/thing" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "local" }],
        "state": "st",
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "unknown-port",
      "why": "the port list is closed. A typo must not silently create a new port.",
      "error": "type",
      "semantic": false,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "st", "type": "computer", "engine": "forge://x@v1", "manager": "local" }],
        "state": "st",
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "alias-not-kebab",
      "why": "aliases are lowercase kebab-case, matching forge enum values.",
      "error": "alias",
      "semantic": false,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "Local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "Local" }],
        "state": "st",
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "Local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "target-needs-forge-or-forgeci",
      "why": "a target that names no work is meaningless.",
      "error": "target",
      "semantic": false,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "local" }],
        "state": "st",
        "targets": [{ "alias": "t" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "unknown-top-level-key",
      "why": "forge silently drops unknown keys. forge-ci must not. A typo in a pipeline is a bug you want reported.",
      "error": "pipelines",
      "semantic": false,
      "doc": {
        "name": "x",
        "pipelines": [],
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "local" }],
        "state": "st",
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    },

    {
      "case": "state-names-nothing",
      "why": "state must name an engine that exists.",
      "error": "state",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "here", "type": "compute", "engine": "forge://x@v1", "manager": "local" }],
        "state": "missing",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "here", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "state-wrong-port",
      "why": "state must name an engine whose type is state, not merely any engine.",
      "error": "state",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "here", "type": "compute", "engine": "forge://x@v1", "manager": "local" }],
        "state": "here",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "here", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "substage-engine-wrong-port",
      "why": "a substage runs on a compute engine. Naming a state engine there is a bug.",
      "error": "substages[0]",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "local" }],
        "state": "st",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "gate-wrong-port",
      "why": "a gate must name a gate engine.",
      "error": "gates",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x@v1", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://x@v1", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "here", "manager": "local", "gates": ["here"], "targets": ["t"] }] }]
      }
    },
    {
      "case": "duplicate-alias",
      "why": "two engines with one alias makes every reference ambiguous.",
      "error": "duplicate",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x@v1", "manager": "local" },
          { "alias": "here", "type": "state", "engine": "forge://y@v1", "manager": "local" }
        ],
        "state": "here",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "here", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "unknown-target",
      "why": "a substage must name a declared target.",
      "error": "targets",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x@v1", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://y@v1", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "here", "manager": "local", "targets": ["nope"] }] }]
      }
    },
    {
      "case": "unknown-repo-in-target",
      "why": "a target that names a repo outside repos would run nowhere.",
      "error": "in",
      "semantic": true,
      "doc": {
        "name": "x",
        "repos": [{ "name": "a", "url": "git@example.com:a.git" }],
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [
          { "alias": "here", "type": "compute", "engine": "forge://x@v1", "manager": "local" },
          { "alias": "st", "type": "state", "engine": "forge://y@v1", "manager": "local" }
        ],
        "state": "st",
        "targets": [{ "alias": "t", "forge": "test-all", "in": ["b"] }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "here", "manager": "local", "targets": ["t"] }] }]
      }
    },
    {
      "case": "unknown-manager",
      "why": "an engine must name a declared manager.",
      "error": "manager",
      "semantic": true,
      "doc": {
        "name": "x",
        "managers": [{ "alias": "local", "engine": "forge://m@v1" }],
        "engines": [{ "alias": "st", "type": "state", "engine": "forge://y@v1", "manager": "nope" }],
        "state": "st",
        "targets": [{ "alias": "t", "forge": "test-all" }],
        "stages": [{ "name": "s", "substages": [{ "name": "d", "engine": "st", "manager": "local", "targets": ["t"] }] }]
      }
    }
  ]
}
