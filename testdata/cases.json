    {
      "case": "many-substages",
      "why": "a stage fans out. Substages carry user params that forge-ci never interprets.",
      "doc": {
        "name": "fanout",
        "managers": [
          {
            "alias": "local",
            "engine": "forge://x/cmd/ci-manager-local@v0.1.0"
          }
        ],
        "engines": [
          {
            "alias": "here",
            "type": "compute",
