            "manager": "local"
          },
          {
            "alias": "st",
            "type": "state",
            "engine": "forge://x/cmd/ci-state-git@v0.1.0",
            "manager": "local"
          },
          {
            "alias": "approve",
            "type": "gate",
            "engine": "forge://x/cmd/ci-gate-manual@v0.1.0",
            "manager": "local"
          },
          {
            "alias": "all-pass",
            "type": "promotion",
            "engine": "forge://x/cmd/ci-promotion-all@v0.1.0",
            "manager": "local"
          }
        ],
        "state": "st",
        "targets": [
          {
            "alias": "deploy",
            "forge": "run deploy --region {{.Params.region}} --cell {{.Params.cell}}"
          }
        ],
        "stages": [
          {
            "name": "prod",
            "promotion": "all-pass",
            "substages": [
              {
                "name": "eu-a",
                "engine": "here",
                "manager": "local",
                "gates": [
                  "approve"
                ],
                "targets": [
                  "deploy"
                ],
                "params": {
                  "region": "eu-west-1",
                  "cell": "a"
                }
              },
              {
                "name": "eu-b",
                "engine": "here",
                "manager": "local",
                "gates": [
                  "approve"
                ],
                "targets": [
                  "deploy"
                ],
                "params": {
                  "region": "eu-west-1",
                  "cell": "b"
                }
              }
            ]
          }
        ]
      }
