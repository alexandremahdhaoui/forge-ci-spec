        ],
        "versioning": {
          "tagPrefix": "forge",
          "strategy": "semantic",
          "cap": "v0",
          "semantic": {
            "major": [
              "!:",
              "BREAKING CHANGE",
              "💥"
            ],
            "minor": [
              "feat:",
              "✨"
            ],
            "patch": [
              "fix:",
              "perf:",
              "🐛"
            ],
            "ignore": [
              "docs:",
              "chore:",
              "test:",
              "style:",
              "📝"
            ],
            "unmatched": "patch"
          }
        }
      }
    },
